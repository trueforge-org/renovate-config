{
  "packageRules": [
    {
      "matchManagers": ["helmv3"],
      "semanticCommitScope": "helm-deps"
    },
    {
      "matchManagers": ["helm-values"],
      "semanticCommitScope": "{{parentDir}}"
    },
    {
      "matchManagers": ["docker"],
      "semanticCommitScope": "{{parentDir}}"
    },
    {
      "matchManagers": ["flux"],
      "semanticCommitScope": "flux"
    }
  ]
}
